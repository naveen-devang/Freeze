{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Freeze",
  "version": "0.1.0",
  "identifier": "app.freeze.pc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Freeze",
        "width": 1080,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
