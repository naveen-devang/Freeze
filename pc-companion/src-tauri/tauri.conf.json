{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Freeze",
  "version": "1.0.0",
  "identifier": "app.freeze.pc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Freeze",
        "width": 1080,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "theme": "Dark"
      }
    ],
    "security": {}
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwMDQ1OTQ4RjQ5QjE4NjcKUldSbkdKdjBTRmtFTVBLQk9sbG1uejUrRjU5bVV4eXRvMXdYRnFHN2Qydk55M0RVaXBrOGc3UkkK",
      "endpoints": [
        "https://github.com/naveen-devang/Freeze/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
